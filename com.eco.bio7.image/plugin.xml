<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>
<plugin>
   <extension
         point="org.eclipse.ui.views">
      <view
            allowMultiple="true"
            category="com.eco.bio7.image.plugin"
            class="com.eco.bio7.image.ui.CanvasView"
            icon="pics/imagejview.svg"
            id="com.eco.bio7.imagej"
            name="ImageJ-Canvas"/>
      <view
            category="com.eco.bio7.image.plugin.extra"
            class="com.eco.bio7.image.thumbs.ThumbnailsView"
            icon="pics/thumbnails.svg"
            id="com.eco.bio7.thumbnails"
            name="Thumbnails"/>
      <view
            allowMultiple="true"
            category="com.eco.bio7.image.plugin"
            class="com.eco.bio7.image.ui.IJtoolbar"
            icon="pics/imagejview.svg"
            id="com.eco.bio7.ijtoolbar"
            name="ImageJ-Toolbar"/>
      <view
            allowMultiple="true"
            category="com.eco.bio7.image.plugin.extra"
            class="com.eco.bio7.image.ui.CustomDetachedImageJView"
            icon="pics/imagejview.svg"
            id="com.eco.bio7.image.detachedImage"
            name="Image"
            restorable="true">
      </view>
      <category
            id="com.eco.bio7.image.plugin"
            name="ImageJ">
      </category>
      <category
            id="com.eco.bio7.image.plugin.extra"
            name="ImageJ Extra"
            parentCategory="com.eco.bio7.image.plugin">
      </category>
   </extension>
   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            category="com.eco.bio7.preferences.Bio7PreferencePage"
            class="com.eco.bio7.image.preferences.Bio7ImageJPreferences"
            id="com.eco.bio7.image.preferences.Bio7ImageJPreferences"
            name="Preferences ImageJ">
      </page>
   </extension>
   <extension
         point="org.eclipse.core.runtime.preferences">
      <initializer
            class="com.eco.bio7.image.preferences.PreferenceInitializer">
      </initializer>
   </extension>
   <extension
         point="org.eclipse.ui.editors">
      <editor
            class="com.eco.bio7.image.ui.ImageJBio7OpenEditor"
            contributorClass="org.eclipse.ui.texteditor.BasicTextEditorActionContributor"
            default="true"
            extensions="jpg,jpeg,tif,tiff,TIF,TIFF,png,bmp,gif,avi,pnm,dcm,roi,pgm,pbm"
            icon="pics/imagefile.svg"
            id="com.eco.bio7.editors.imagej.editor"
            name="ImageJ Image Editor"
            symbolicFontName="com.eco.bio7.imagej.editor">
      </editor>
   </extension>
   <extension
         point="org.eclipse.ui.popupMenus">
      <objectContribution
            adaptable="false"
            id="OpenDirectoryInThumbnailsFolder"
            objectClass="org.eclipse.core.resources.IFolder">
         <action
               class="com.eco.bio7.image.popup.action.OpenImageThumbnailView"
               icon="pics/thumbnails.svg"
               id="com.eco.bio7.image.open.thumbnail.view"
               label="Open in Thumbnail view"
               menubarPath="additions.path"
               tooltip="Open image directory in Thumbnail View">
         </action>
      </objectContribution>
      <objectContribution
            adaptable="false"
            id="OpenDirectoryInThumbnailsProject"
            objectClass="org.eclipse.core.resources.IProject">
         <action
               class="com.eco.bio7.image.popup.action.OpenImageThumbnailView"
               icon="pics/thumbnails.svg"
               id="com.eco.bio7.image.open.thumbnail.view"
               label="Open in Thumbnail view"
               menubarPath="additions.path"
               tooltip="Open image directory in Thumbnail View">
         </action>
      </objectContribution>
   </extension>

   <!-- Markers with quick fixes which tools place with the ij.swt.CodeEditor API (see WorkbenchCodeEditors).
        Annotation types of their own, so the markers and quick fixes of the editors are not changed! -->
   <extension
         point="org.eclipse.ui.editors.annotationTypes">
      <type
            name="com.eco.bio7.image.codeMarker.error">
      </type>
      <type
            name="com.eco.bio7.image.codeMarker.warning">
      </type>
      <type
            name="com.eco.bio7.image.codeMarker.info">
      </type>
   </extension>
   <extension
         point="org.eclipse.ui.editors.markerAnnotationSpecification">
      <specification
            annotationType="com.eco.bio7.image.codeMarker.error"
            colorPreferenceKey="com.eco.bio7.image.codeMarker.error.color"
            colorPreferenceValue="230,40,40"
            contributesToHeader="false"
            includeOnPreferencePage="true"
            label="Code Tool Errors"
            overviewRulerPreferenceKey="com.eco.bio7.image.codeMarker.error.overview"
            overviewRulerPreferenceValue="true"
            presentationLayer="6"
            symbolicIcon="error"
            textPreferenceKey="com.eco.bio7.image.codeMarker.error.text"
            textPreferenceValue="true"
            textStylePreferenceKey="com.eco.bio7.image.codeMarker.error.style"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceKey="com.eco.bio7.image.codeMarker.error.vertical"
            verticalRulerPreferenceValue="true">
      </specification>
      <specification
            annotationType="com.eco.bio7.image.codeMarker.warning"
            colorPreferenceKey="com.eco.bio7.image.codeMarker.warning.color"
            colorPreferenceValue="235,165,0"
            contributesToHeader="false"
            includeOnPreferencePage="true"
            label="Code Tool Warnings"
            overviewRulerPreferenceKey="com.eco.bio7.image.codeMarker.warning.overview"
            overviewRulerPreferenceValue="true"
            presentationLayer="5"
            symbolicIcon="warning"
            textPreferenceKey="com.eco.bio7.image.codeMarker.warning.text"
            textPreferenceValue="true"
            textStylePreferenceKey="com.eco.bio7.image.codeMarker.warning.style"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceKey="com.eco.bio7.image.codeMarker.warning.vertical"
            verticalRulerPreferenceValue="true">
      </specification>
      <specification
            annotationType="com.eco.bio7.image.codeMarker.info"
            colorPreferenceKey="com.eco.bio7.image.codeMarker.info.color"
            colorPreferenceValue="60,130,200"
            contributesToHeader="false"
            includeOnPreferencePage="true"
            label="Code Tool Infos"
            overviewRulerPreferenceKey="com.eco.bio7.image.codeMarker.info.overview"
            overviewRulerPreferenceValue="true"
            presentationLayer="4"
            symbolicIcon="info"
            textPreferenceKey="com.eco.bio7.image.codeMarker.info.text"
            textPreferenceValue="true"
            textStylePreferenceKey="com.eco.bio7.image.codeMarker.info.style"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceKey="com.eco.bio7.image.codeMarker.info.vertical"
            verticalRulerPreferenceValue="true">
      </specification>
   </extension>

   <!-- Removes the markers of the tools (not the markers of the editors) from the active editor! -->
   <extension
         point="org.eclipse.ui.commands">
      <command
            categoryId="org.eclipse.ui.category.textEditor"
            description="Removes the markers which tools (e.g., an assistant) placed in the active editor"
            id="com.eco.bio7.image.removeCodeMarkers"
            name="Remove Code Tool Markers">
      </command>
   </extension>
   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="com.eco.bio7.image.ui.RemoveCodeMarkersHandler"
            commandId="com.eco.bio7.image.removeCodeMarkers">
      </handler>
   </extension>
   <extension
         point="org.eclipse.core.expressions.propertyTesters">
      <propertyTester
            class="com.eco.bio7.image.ui.CodeMarkersPropertyTester"
            id="com.eco.bio7.image.codeMarkersTester"
            namespace="com.eco.bio7.image"
            properties="hasCodeMarkers"
            type="org.eclipse.ui.IEditorPart">
      </propertyTester>
   </extension>
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="popup:#REditorContext?after=additions">
         <command
               commandId="com.eco.bio7.image.removeCodeMarkers"
               style="push">
               <visibleWhen
                     checkEnabled="false">
                  <with
                        variable="activeEditor">
                     <test
                           forcePluginActivation="true"
                           property="com.eco.bio7.image.hasCodeMarkers">
                     </test>
                  </with>
               </visibleWhen>
         </command>
      </menuContribution>
      <menuContribution
            locationURI="popup:#IJMacroContext?after=additions">
         <command
               commandId="com.eco.bio7.image.removeCodeMarkers"
               style="push">
               <visibleWhen
                     checkEnabled="false">
                  <with
                        variable="activeEditor">
                     <test
                           forcePluginActivation="true"
                           property="com.eco.bio7.image.hasCodeMarkers">
                     </test>
                  </with>
               </visibleWhen>
         </command>
      </menuContribution>
      <menuContribution
            locationURI="popup:#RMarkdownEditorContext?after=additions">
         <command
               commandId="com.eco.bio7.image.removeCodeMarkers"
               style="push">
               <visibleWhen
                     checkEnabled="false">
                  <with
                        variable="activeEditor">
                     <test
                           forcePluginActivation="true"
                           property="com.eco.bio7.image.hasCodeMarkers">
                     </test>
                  </with>
               </visibleWhen>
         </command>
      </menuContribution>
      <menuContribution
            locationURI="popup:#TextEditorContext?after=additions">
         <command
               commandId="com.eco.bio7.image.removeCodeMarkers"
               style="push">
               <visibleWhen
                     checkEnabled="false">
                  <with
                        variable="activeEditor">
                     <test
                           forcePluginActivation="true"
                           property="com.eco.bio7.image.hasCodeMarkers">
                     </test>
                  </with>
               </visibleWhen>
         </command>
      </menuContribution>
      <menuContribution
            locationURI="popup:#CompilationUnitEditorContext?after=additions">
         <command
               commandId="com.eco.bio7.image.removeCodeMarkers"
               style="push">
               <visibleWhen
                     checkEnabled="false">
                  <with
                        variable="activeEditor">
                     <test
                           forcePluginActivation="true"
                           property="com.eco.bio7.image.hasCodeMarkers">
                     </test>
                  </with>
               </visibleWhen>
         </command>
      </menuContribution>
      <menuContribution
            locationURI="popup:#TextRulerContext?after=additions">
         <command
               commandId="com.eco.bio7.image.removeCodeMarkers"
               style="push">
               <visibleWhen
                     checkEnabled="false">
                  <with
                        variable="activeEditor">
                     <test
                           forcePluginActivation="true"
                           property="com.eco.bio7.image.hasCodeMarkers">
                     </test>
                  </with>
               </visibleWhen>
         </command>
      </menuContribution>
      <menuContribution
            locationURI="popup:#CompilationUnitRulerContext?after=additions">
         <command
               commandId="com.eco.bio7.image.removeCodeMarkers"
               style="push">
               <visibleWhen
                     checkEnabled="false">
                  <with
                        variable="activeEditor">
                     <test
                           forcePluginActivation="true"
                           property="com.eco.bio7.image.hasCodeMarkers">
                     </test>
                  </with>
               </visibleWhen>
         </command>
      </menuContribution>
   </extension>

</plugin>
