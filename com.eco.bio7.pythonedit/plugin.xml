<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension
         point="org.eclipse.ui.editors">
      <editor
            class="com.eco.bio7.editors.python.PythonEditor"
            contributorClass="org.eclipse.ui.texteditor.BasicTextEditorActionContributor"
            default="true"
            extensions="py"
            icon="icons/python.svg"
            id="com.eco.bio7.pythoneditors.PythonEditor"
            name="Python Editor"
            symbolicFontName="com.eco.bio7.pythoneditor.textfont">
      </editor>
   </extension>
   <extension
         id="ExampleJavaDocumentSetupParticipant"
         name="%documentSetupParticipantName"
         point="org.eclipse.core.filebuffers.documentSetup">
      <participant
            extensions="py"
            class="com.eco.bio7.pythoneditors.ScriptDocumentSetupParticipant">
      </participant>
   </extension>

   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            category="prefpython"
            class="com.eco.bio7.reditor.preferences.TemplatesPreferencePage"
            id="org.eclipse.ui.examples.templateeditor.preferencepage"
            name="Template Editor Python">
      </page>
      <page
            category="com.eco.bio7.preferences.Bio7PreferencePage"
            class="com.eco.bio7.reditor.preferences.WorkbenchPreferencePython"
            id="prefpython"
            name="Preferences Python Editor"/>
      <page
            category="prefpython"
            class="com.eco.bio7.reditor.preferences.PythonCodePreferences"
            id="com.eco.bio7.pythonedit.code"
            name="Preferences Python Editor Code">
      </page>
      <page
            category="prefpython"
            class="com.eco.bio7.reditor.preferences.PythonCodeAnalysisPreferences"
            id="com.eco.bio7.pythonedit.analysis"
            name="Preferences Python Editor Code Analysis">
      </page>
      <page
            category="prefpython"
            class="com.eco.bio7.reditor.preferences.PythonFormatPreferences"
            id="com.eco.bio7.pythonedit.formatting"
            name="Preferences Python Editor Formatting">
      </page>
   </extension>

   <extension
         point="org.eclipse.ui.editors.templates">
      <contextType
            name="Python Templates"
            class="com.eco.bio7.reditor.preferences.template.PythonContextType"
            id="py">
      </contextType>
     
      <include
      		file="templates/ant.xml"
      		translations="$nl$/templates/ant.properties">
      </include>
   </extension>
   <extension
        point="org.eclipse.core.runtime.preferences">
     <initializer
           class="com.eco.bio7.reditor.preferences.PreferenceInitializer">
     </initializer>
  </extension>
  <extension
     point="org.eclipse.ui.themes">
  <fontDefinition
        label="Python Editor Font"
        defaultsTo="org.eclipse.jface.textfont"
        categoryId="com.eco.bio7.pythoneditor.theme"
        id="com.eco.bio7.pythoneditor.textfont">
     
  </fontDefinition>
  <themeElementCategory
        id="com.eco.bio7.pythoneditor.theme"
        label="Python editor">
  </themeElementCategory>
 </extension>
 <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="com.eco.bio7.pythoneditor.actions.TextZoomInHandler"
            commandId="com.eco.bio7.pythoneditor.actions.text.zoomIn">
           
      </handler>
      <handler
            class="com.eco.bio7.pythoneditor.actions.TextZoomOutHandler"
            commandId="com.eco.bio7.pythoneditor.actions.text.zoomOut">
           
      </handler>
     
   </extension>
   <extension
       id="com.eco.bio7.pythoneditor.refactor.rename"
       point="org.eclipse.ui.bindings">
        <sequenceModifier
  			find="CTRL"
  			replace="COMMAND"
  			platforms="cocoa,carbon" />
     
   
    <key
          commandId="com.eco.bio7.pythoneditor.refactor.rename"
          contextId="com.eco.bio7.python.editor.scope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M2+M3+R">
    </key>
    <key
          commandId="com.eco.bio7.pythoneditor.refactor.extract.variable"
          contextId="com.eco.bio7.python.editor.scope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M2+M3+L">
    </key>
    <key
          commandId="com.eco.bio7.pythoneditor.refactor.extract.function"
          contextId="com.eco.bio7.python.editor.scope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M2+M3+M">
    </key>
    <key
          commandId="com.eco.bio7.pythoneditor.refactor.inline"
          contextId="com.eco.bio7.python.editor.scope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M2+M3+I">
    </key>
    <key
          commandId="com.eco.bio7.pythoneditor.refactor.imports"
          contextId="com.eco.bio7.python.editor.scope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M1+M2+O">
    </key>
    <key
          commandId="com.eco.bio7.pythoneditor.refactor.docstring"
          contextId="com.eco.bio7.python.editor.scope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M2+M3+J">
    </key>
    <key
          commandId="com.eco.bio7.pythoneditor.format"
          contextId="com.eco.bio7.python.editor.scope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M1+M2+F">
    </key>
    <key
          commandId="com.eco.bio7.pythoneditor.actions.text.zoomIn"
          contextId="com.eco.bio7.python.editor.scope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="CTRL++">
    </key>
    <key
          commandId="com.eco.bio7.pythoneditor.actions.text.zoomOut"
          contextId="com.eco.bio7.python.editor.scope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="CTRL+-">
    </key>
    </extension>
   <extension 
   point="org.eclipse.ui.commands">
       <command
          categoryId="org.eclipse.ui.category.textEditor"
          description="Renames the variable, function or class at the cursor in this file"
          id="com.eco.bio7.pythoneditor.refactor.rename"
          name="Rename (Python)">
    </command>
       <command
          categoryId="org.eclipse.ui.category.textEditor"
          description="Assigns the selected expression to a new variable"
          id="com.eco.bio7.pythoneditor.refactor.extract.variable"
          name="Extract Variable (Python)">
    </command>
       <command
          categoryId="org.eclipse.ui.category.textEditor"
          description="Moves the selected statements into a new function"
          id="com.eco.bio7.pythoneditor.refactor.extract.function"
          name="Extract Function (Python)">
    </command>
       <command
          categoryId="org.eclipse.ui.category.textEditor"
          description="Replaces the variable at the cursor with its value"
          id="com.eco.bio7.pythoneditor.refactor.inline"
          name="Inline Variable (Python)">
    </command>
       <command
          categoryId="org.eclipse.ui.category.textEditor"
          description="Sorts the imports (and removes unused imports with ruff)"
          id="com.eco.bio7.pythoneditor.refactor.imports"
          name="Organize Imports (Python)">
    </command>
       <command
          categoryId="org.eclipse.ui.category.textEditor"
          description="Surrounds the selected lines with try and except"
          id="com.eco.bio7.pythoneditor.refactor.surround"
          name="Surround with try/except (Python)">
    </command>
       <command
          categoryId="org.eclipse.ui.category.textEditor"
          description="Inserts a docstring into the function or class at the cursor"
          id="com.eco.bio7.pythoneditor.refactor.docstring"
          name="Insert Docstring (Python)">
    </command>
       <command
          categoryId="org.eclipse.ui.category.textEditor"
          description="Formats the Python code with ruff or black"
          id="com.eco.bio7.pythoneditor.format"
          name="Format Python Code">
    </command>
       <command
          categoryId="org.eclipse.ui.category.textEditor"
          description="Zoom in text, increase default font size for text editors"
          id="com.eco.bio7.pythoneditor.actions.text.zoomIn"
          name="Zoom In">
    </command>
    <command
          categoryId="org.eclipse.ui.category.textEditor"
          description="Zoom out text, decrease default font size for text editors"
          id="com.eco.bio7.pythoneditor.actions.text.zoomOut"
          name="Zoom Out">
    </command>
     
   </extension>
   <!-- The markers of the code analysis of the Python editor (errors, warnings with quick fixes) -->
   <extension
         id="problem"
         name="Python Problem"
         point="org.eclipse.core.resources.markers">
      <super type="org.eclipse.core.resources.problemmarker"/>
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="false"/>
   </extension>
   <!-- The breakpoints of Python scripts (kept with the file) and the line of the stopped debugger -->
   <extension
         id="breakpoint"
         name="Python Breakpoint"
         point="org.eclipse.core.resources.markers">
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="true"/>
   </extension>
   <extension
         id="profileline"
         name="Python Profile"
         point="org.eclipse.core.resources.markers">
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="false"/>
   </extension>
   <extension
         id="conditionalbreakpoint"
         name="Python Conditional Breakpoint"
         point="org.eclipse.core.resources.markers">
      <super type="com.eco.bio7.pythonedit.breakpoint"/>
      <persistent value="true"/>
   </extension>
   <extension
         id="debugline"
         name="Python Debug Line"
         point="org.eclipse.core.resources.markers">
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="false"/>
   </extension>
   <extension point="org.eclipse.ui.editors.annotationTypes">
      <type markerType="com.eco.bio7.pythonedit.breakpoint" name="com.eco.bio7.pythonedit.breakpoint"/>
      <type markerType="com.eco.bio7.pythonedit.conditionalbreakpoint" name="com.eco.bio7.pythonedit.conditionalbreakpoint"
            super="com.eco.bio7.pythonedit.breakpoint"/>
      <type markerType="com.eco.bio7.pythonedit.debugline" name="com.eco.bio7.pythonedit.debugline"/>
      <type markerType="com.eco.bio7.pythonedit.profileline" name="com.eco.bio7.pythonedit.profileline"/>
   </extension>
   <extension point="org.eclipse.ui.editors.markerAnnotationSpecification">
      <specification
            annotationType="com.eco.bio7.pythonedit.breakpoint"
            colorPreferenceKey="com.eco.bio7.pythonedit.breakpoint.color"
            colorPreferenceValue="70,130,220"
            contributesToHeader="false"
            highlightPreferenceKey="com.eco.bio7.pythonedit.breakpoint.highlight"
            highlightPreferenceValue="false"
            icon="icons/debug/brkp_obj.svg"
            includeOnPreferencePage="true"
            label="Python Breakpoint"
            overviewRulerPreferenceKey="com.eco.bio7.pythonedit.breakpoint.overview"
            overviewRulerPreferenceValue="true"
            presentationLayer="3"
            textPreferenceKey="com.eco.bio7.pythonedit.breakpoint.text"
            textPreferenceValue="false"
            verticalRulerPreferenceKey="com.eco.bio7.pythonedit.breakpoint.ruler"
            verticalRulerPreferenceValue="true"/>
      <specification
            annotationType="com.eco.bio7.pythonedit.conditionalbreakpoint"
            colorPreferenceKey="com.eco.bio7.pythonedit.conditionalbreakpoint.color"
            colorPreferenceValue="240,160,32"
            contributesToHeader="false"
            highlightPreferenceKey="com.eco.bio7.pythonedit.conditionalbreakpoint.highlight"
            highlightPreferenceValue="false"
            icon="icons/debug/brkp_cond_obj.svg"
            includeOnPreferencePage="true"
            label="Python Conditional Breakpoint"
            overviewRulerPreferenceKey="com.eco.bio7.pythonedit.conditionalbreakpoint.overview"
            overviewRulerPreferenceValue="true"
            presentationLayer="3"
            textPreferenceKey="com.eco.bio7.pythonedit.conditionalbreakpoint.text"
            textPreferenceValue="false"
            verticalRulerPreferenceKey="com.eco.bio7.pythonedit.conditionalbreakpoint.ruler"
            verticalRulerPreferenceValue="true"/>
      <specification
            annotationType="com.eco.bio7.pythonedit.profileline"
            colorPreferenceKey="com.eco.bio7.pythonedit.profileline.color"
            colorPreferenceValue="232,89,12"
            contributesToHeader="false"
            highlightPreferenceKey="com.eco.bio7.pythonedit.profileline.highlight"
            highlightPreferenceValue="false"
            icon="icons/debug/profile_obj.svg"
            includeOnPreferencePage="true"
            label="Python Profile (time of a line)"
            overviewRulerPreferenceKey="com.eco.bio7.pythonedit.profileline.overview"
            overviewRulerPreferenceValue="true"
            presentationLayer="2"
            textPreferenceKey="com.eco.bio7.pythonedit.profileline.text"
            textPreferenceValue="false"
            verticalRulerPreferenceKey="com.eco.bio7.pythonedit.profileline.ruler"
            verticalRulerPreferenceValue="true"/>
      <specification
            annotationType="com.eco.bio7.pythonedit.debugline"
            colorPreferenceKey="com.eco.bio7.pythonedit.debugline.color"
            colorPreferenceValue="180,230,180"
            contributesToHeader="false"
            highlightPreferenceKey="com.eco.bio7.pythonedit.debugline.highlight"
            highlightPreferenceValue="true"
            icon="icons/debug/occ_match.svg"
            includeOnPreferencePage="true"
            label="Python Debug Line"
            overviewRulerPreferenceKey="com.eco.bio7.pythonedit.debugline.overview"
            overviewRulerPreferenceValue="true"
            presentationLayer="4"
            textPreferenceKey="com.eco.bio7.pythonedit.debugline.text"
            textPreferenceValue="false"
            verticalRulerPreferenceKey="com.eco.bio7.pythonedit.debugline.ruler"
            verticalRulerPreferenceValue="true"/>
   </extension>
   <extension point="org.eclipse.ui.contexts">
          <context name="Python Editor Context"
           description="Python Editor Context"
           parentId="org.eclipse.ui.textEditorScope"
           id="com.eco.bio7.python.editor.scope" />
   </extension>

</plugin>
