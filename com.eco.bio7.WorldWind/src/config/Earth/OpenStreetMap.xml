<!-- Open Street Map imagery -->
<!--
  Changed for Bio7: the OpenStreetMap WMS of terrestris (free, worldwind20.arc.nasa.gov is not available):
  (c) OpenStreetMap contributors (https://www.openstreetmap.org/copyright), WMS by terrestris GmbH &amp; Co. KG
  (https://www.terrestris.de). WMS 1.1.1: the server has no CRS:84 (requested by WMS 1.3), EPSG:4326 instead.
-->
<!--$Id: OpenStreetMap.xml 1171 2013-02-11 21:45:02Z dcollins $-->
<Layer version="1" layerType="TiledImageLayer">
    <DisplayName>OpenStreetMap (terrestris)</DisplayName>
    <Service serviceName="OGC:WMS" version="1.1.1">
        <GetCapabilitiesURL>https://ows.terrestris.de/osm/service</GetCapabilitiesURL>
        <GetMapURL>https://ows.terrestris.de/osm/service</GetMapURL>
        <LayerNames>OSM-WMS</LayerNames>
    </Service>
    <DataDetailHint>0.40</DataDetailHint>
    <RetrievePropertiesFromService>true</RetrievePropertiesFromService>
    <!-- day month year hours:minutes:seconds timezone -->
    <LastUpdate>01 11 2012 22:52:00 GMT</LastUpdate>
    <DataCacheName>Earth/OpenStreetMap-terrestris</DataCacheName>
    <ImageFormat>image/png</ImageFormat>
    <AvailableImageFormats>
        <ImageFormat>image/png</ImageFormat>
        <ImageFormat>image/jpeg</ImageFormat>
    </AvailableImageFormats>
    <FormatSuffix>.png</FormatSuffix>
    <NumLevels count="16" numEmpty="0"/>
    <TileOrigin>
        <LatLon units="degrees" latitude="-90" longitude="-180"/>
    </TileOrigin>
    <LevelZeroTileDelta>
        <LatLon units="degrees" latitude="36" longitude="36"/>
    </LevelZeroTileDelta>
    <TileSize>
        <Dimension width="512" height="512"/>
    </TileSize>
    <Sector>
        <SouthWest>
            <LatLon units="degrees" latitude="-90" longitude="-180"/>
        </SouthWest>
        <NorthEast>
            <LatLon units="degrees" latitude="90" longitude="180"/>
        </NorthEast>
    </Sector>
    <ForceLevelZeroLoads>false</ForceLevelZeroLoads>
    <RetainLevelZeroTiles>false</RetainLevelZeroTiles>
    <UseTransparentTextures>false</UseTransparentTextures>
    <!--<ScreenCredit creditType="ScreenImage">-->
        <!--<FileName>images/Bing_32x32.png</FileName>-->
        <!--<Link>http://www.microsoft.com/maps/assets/docs/terms.aspx/</Link>-->
    <!--</ScreenCredit>-->
    <RetrievalTimeouts>
        <ReadTimeout>
            <Time units="milliseconds" value="20000"/>
        </ReadTimeout>
    </RetrievalTimeouts>
</Layer>
